# EXAMPLE ONLY. Spring Boot does not automatically load .env files.
# Set these in your private process environment; do not commit the filled values.
# This template is for a member's own NEW database, not Long's existing demo DB.
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=racehorse_local_<member>_<timestamp>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=<your_certificate_SAN>;integratedSecurity=true
DB_USERNAME=
DB_PASSWORD=
SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_TRUSTSTORE=<absolute_path_to_your_own_PKCS12_truststore>
SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_TRUSTSTORETYPE=PKCS12
SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_TRUSTSTOREPASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_SQL_INIT_MODE=never
SPRING_APPLICATION_JSON={"app":{"realtime":{"simulator":{"enabled":false}}}}
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Keep JWT_SIGNING_KEY stable in your private OS-protected config between restarts.
# Require at least 32 random bytes encoded as Base64; never share a common team key.
# Integrated authentication also needs the matching mssql-jdbc_auth DLL on java.library.path.
# For SQL authentication remove integratedSecurity=true and set your own DB_USERNAME/DB_PASSWORD.
# No SQL password, JWT secret, truststore password or private key belongs in the FE VITE_* environment.
