# TEMPLATE ONLY. Set in a private local shell. Never commit actual credentials.
RH_DATABASE=racehorse_local_<member>_<unique_timestamp>
RH_SQL_HOST=localhost
RH_SQL_PORT=1433
RH_SQL_CERT_HOST=<hostname_in_your_SQL_certificate_SAN>
RH_SQL_TRUSTSTORE=<absolute_path_to_your_dedicated_PKCS12_truststore>
RH_SQL_TRUSTSTORE_PASSWORD=<local_secret>
RH_JDBC_DRIVER=<absolute_path_to_mssql_jdbc_jar>
RH_JDBC_NATIVE_DIR=<directory_of_matching_Windows_integrated_auth_DLL>
# Blank username uses Windows integrated authentication; otherwise both secrets required.
RH_SQL_USERNAME=
RH_SQL_PASSWORD=
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=<same_RH_DATABASE>;encrypt=true;trustServerCertificate=false;hostNameInCertificate=<same_RH_SQL_CERT_HOST>;integratedSecurity=true
DB_USERNAME=
DB_PASSWORD=
SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_TRUSTSTORE=<same_RH_SQL_TRUSTSTORE>
SPRING_DATASOURCE_HIKARI_DATASOURCEPROPERTIES_TRUSTSTOREPASSWORD=<local_secret>
JWT_SIGNING_KEY=<Base64_of_at_least_32_random_bytes>
JWT_ACCESS_TOKEN_TTL_SECONDS=3600
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_ROLE_TEST_LOGIN=false
VITE_BUSINESS_DATA_SOURCE=api
