# Normalise text files in the repository.
* text=auto

# The approved schema must stay byte-identical to project-docs/database/schema.sql (LF endings),
# otherwise the SHA-256 check in scripts/db/setup-dev-db.ps1 fails. Never convert line endings.
database/schema.sql -text
database/schema.sql.sha256 -text

*.java text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
